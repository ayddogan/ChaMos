@page "/login"
@inject HttpClient Http
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Web

<PageTitle>ChaMos - Giriş Yap</PageTitle>

<div class="full-bleed auth-page-background">
    <div class="auth-card" style="max-width: 400px; width: 100%; text-align: center;">
        <h1 style="color: var(--color-navy); margin-bottom: 8px;">ChaMos</h1>
        <p style="color: #888; margin-bottom: 30px;">Hesabına giriş yap</p>

        <div style="margin-bottom: 18px; text-align: left;">
            <label style="font-size: 15px; color: #555; font-weight: 600;">E-posta</label>
            <input @bind="email"
                   style="width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; margin-top: 4px;" />
        </div>

        <div style="margin-bottom: 24px; text-align: left;">
            <label style="font-size: 15px; color: #555; font-weight: 600;">Parola</label>
            <div style="position: relative;">
                <input type="@(showPassword ? "text" : "password")" @bind="password"
                    style="width: 100%; font-size: 16px; padding: 10px 40px 10px 12px; border: 1px solid #ddd; border-radius: 8px; margin-top: 4px; box-sizing: border-box;"
                    @onkeyup="HandleKeyUp" />
                <span style="position: absolute; right: 12px; top: 50%; transform: translateY(calc(-50% + 2px)); cursor: pointer; font-size: 16px;"
                    @onclick="() => showPassword = !showPassword">
                    @(showPassword ? "🙈" : "👁️")
                </span>
            </div>
        </div>

        <button class="btn btn-primary" style="width: 100%; font-size: 16px; padding: 12px; border-radius: 8px;" @onclick="HandleLogin">
            Giriş Yap
        </button>

        <p style="color: #d9534f; margin-top: 12px;">@message</p>

        <p style="margin-top: 12px;">
            <a href="forgot-password" style="color: var(--color-purple); font-size: 14px;">Şifremi unuttum</a>
        </p>
        <p style="margin-top: 20px; color: #888;">
            Hesabın yok mu? <a href="register" style="color: var(--color-purple); font-weight: 600;">Kayıt Ol</a>
        </p>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool showPassword = false;
    private string message = string.Empty;

    private class LoginResponse
    {
        public string AccessToken { get; set; } = string.Empty;
        public string RefreshToken { get; set; } = string.Empty;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        message = "Giriş yapılıyor...";

        var loginRequest = new { email, password };
        var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (result != null)
            {
                await JS.InvokeVoidAsync("localStorageHelper.setItem", "accessToken", result.AccessToken);
                await JS.InvokeVoidAsync("localStorageHelper.setItem", "refreshToken", result.RefreshToken);
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
        else
        {
            var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            message = errorResult?.Message ?? "Giriş yapılamadı, lütfen tekrar deneyin.";
        }
    }

    private class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}