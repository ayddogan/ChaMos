@page "/forgot-password"
@inject HttpClient Http

<PageTitle>ChaMos - Şifremi Unuttum</PageTitle>

<div class="auth-page-background full-bleed">
    <div class="auth-card" style="max-width: 400px; width: 100%; text-align: center;">
        <h1 style="color: var(--color-navy); margin-bottom: 8px;">Şifremi Unuttum</h1>
        <p style="color: #888; margin-bottom: 30px;">Email adresini gir, sana bir sıfırlama linki gönderelim.</p>

        @if (!isSubmitted)
        {
            <div style="margin-bottom: 18px; text-align: left;">
                <label style="font-size: 15px; color: #555; font-weight: 600;">E-posta</label>
                <input @bind="email"
                       style="width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; margin-top: 4px;" />
            </div>

            <button class="btn btn-primary" style="width: 100%; font-size: 16px; padding: 12px; border-radius: 8px;" @onclick="HandleSubmit">
                Sıfırlama Linki Gönder
            </button>
        }
        else
        {
            <p style="color: #5cb85c;">@message</p>
        }

        <p style="margin-top: 20px; color: #888;">
            <a href="login" style="color: var(--color-purple); font-weight: 600;">Giriş sayfasına dön</a>
        </p>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string message = string.Empty;
    private bool isSubmitted = false;

    private async Task HandleSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/auth/forgot-password", new { email });
        var result = await response.Content.ReadFromJsonAsync<MessageResponse>();

        message = result?.Message ?? "Bir hata oluştu, lütfen tekrar dene.";
        isSubmitted = true;
    }

    private class MessageResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}