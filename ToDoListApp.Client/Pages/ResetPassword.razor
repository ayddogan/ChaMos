@page "/reset-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>ChaMos - Yeni Şifre Belirle</PageTitle>

<div class="auth-page-background full-bleed">
    <div class="auth-card" style="max-width: 400px; width: 100%; text-align: center;">
        <h1 style="color: var(--color-navy); margin-bottom: 20px;">Yeni Şifre Belirle</h1>

        @if (string.IsNullOrEmpty(Token))
        {
            <p style="color: #d9534f;">Geçersiz sıfırlama linki.</p>
        }
        else if (!isSuccess)
        {
            <div style="margin-bottom: 18px; text-align: left;">
                <label style="font-size: 15px; color: #555; font-weight: 600;">Yeni Parola</label>
                <input type="password" @bind="newPassword"
                       style="width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; margin-top: 4px;" />
            </div>

            <button class="btn btn-primary" style="width: 100%; font-size: 16px; padding: 12px; border-radius: 8px;" @onclick="HandleReset">
                Şifreyi Güncelle
            </button>

            @if (!string.IsNullOrEmpty(message))
            {
                <p style="color: #d9534f; margin-top: 12px;">@message</p>
            }
        }
        else
        {
            <p style="color: #5cb85c;">@message</p>
            <a class="btn btn-primary" href="login" style="margin-top: 20px; padding: 10px 28px; border-radius: 8px;">
                Giriş Yap
            </a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string newPassword = string.Empty;
    private string message = string.Empty;
    private bool isSuccess = false;

    private async Task HandleReset()
    {
        var response = await Http.PostAsJsonAsync("api/auth/reset-password", new { token = Token, newPassword });
        var result = await response.Content.ReadFromJsonAsync<MessageResponse>();

        message = result?.Message ?? "Bir hata oluştu, lütfen tekrar dene.";
        isSuccess = response.IsSuccessStatusCode;
    }

    private class MessageResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}