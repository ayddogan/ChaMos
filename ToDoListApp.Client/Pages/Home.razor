@page "/"
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@inject HttpClient Http
@inject ToDoListApp.Client.Services.ApiClient Api
@using System.Net.Http.Headers

<PageTitle>ChaMos</PageTitle>

@if (isChecking)
{
    <div style="text-align: center; margin-top: 100px;">
        <p>Yükleniyor...</p>
    </div>
}
else if (!isLoggedIn)
{
    <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--gradient-light);">
        <div style="text-align: center; padding: 40px;">
            <img src="images/icon.png" alt="ChaMos logo" style="height: 180px; margin-bottom: 24px;" />
            <h1 style="font-size: 52px; color: var(--color-navy); margin-bottom: 8px; font-weight: 700;">ChaMos</h1>
            <p style="font-size: 20px; font-style: italic; color: var(--color-purple); margin-bottom: 30px;">
                From Chaos to Cosmos.
            </p>
            <p style="font-size: 17px; color: #666; margin-bottom: 30px;">
                Devam etmek için giriş yapın veya kayıt olun.
            </p>

            <div style="display: flex; flex-wrap: wrapa; gap: 12px;justify-content: center;">
                <a class="btn btn-primary" href="login" style="font-size: 17px; padding: 12px 32px; border-radius: 8px; margin-right: 12px;">
                    Giriş Yap
                </a>
                <a class="btn" href="register"
                    style="font-size: 17px; padding: 12px 32px; border-radius: 8px; background: white; color: var(--color-purple); border: 2px solid var(--color-purple);">
                    Kayıt Ol
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div style="max-width: 800px; margin: 0 auto; padding: 30px 20px;">
        <div style="text-align: center; margin-bottom: 30px;">
            <img src="images/icon.png" alt="ChaMos logo" style="height: 70px; margin-bottom: 10px;" />
            <h1 style="font-size: 28px; color: var(--color-navy); margin-bottom: 6px;">@GetGreeting()</h1>
        </div>

        @if (activeReminders.Any())
        {
            <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 10px; padding: 16px; margin-bottom: 20px;">
                <strong style="color: #856404;">🔔 Hatırlatmalar</strong>
                <ul style="margin: 8px 0 0 0; padding-left: 20px;">
                    @foreach (var reminder in activeReminders)
                    {
                        <li style="color: #856404;">
                            <strong>@reminder.Title</strong>
                            @if (reminder.StartDate.HasValue)
                            {
                                <span> — 🚀 @reminder.StartDate.Value.ToLocalTime().ToString("dd MMMM, HH:mm")</span>
                            }
                            @if (reminder.DueDate.HasValue)
                            {
                                <span> — 🏁 @reminder.DueDate.Value.ToLocalTime().ToString("dd MMMM, HH:mm")</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        <div style="display: flex; gap: 14px; margin-bottom: 30px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 140px; background: white; border-radius: 12px; padding: 18px; text-align: center; box-shadow: 0 2px 10px rgba(26,26,62,0.06);">
                <div style="font-size: 32px; font-weight: 700; color: var(--color-navy);">@totalCount</div>
                <div style="font-size: 13px; color: #888; margin-top: 4px;">Toplam Plan</div>
            </div>
            <div style="flex: 1; min-width: 140px; background: white; border-radius: 12px; padding: 18px; text-align: center; box-shadow: 0 2px 10px rgba(26,26,62,0.06);">
                <div style="font-size: 32px; font-weight: 700; color: #5cb85c;">@completedCount</div>
                <div style="font-size: 13px; color: #888; margin-top: 4px;">Tamamlanan</div>
            </div>
            <div style="flex: 1; min-width: 140px; background: white; border-radius: 12px; padding: 18px; text-align: center; box-shadow: 0 2px 10px rgba(26,26,62,0.06);">
                <div style="font-size: 32px; font-weight: 700; color: #e08b17;">@pendingCount</div>
                <div style="font-size: 13px; color: #888; margin-top: 4px;">Bekleyen</div>
            </div>
        </div>

        <h2 style="font-size: 20px; color: var(--color-navy); margin-bottom: 14px;">Yaklaşan Planlar</h2>

        @if (upcomingTodos.Any())
        {
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var todo in upcomingTodos)
                {
                    var relevantDate = todo.DueDate ?? todo.StartDate;
                    var isOverdue = relevantDate.HasValue && relevantDate.Value < DateTime.UtcNow;

                    <li style="background: white; border-radius: 10px; padding: 12px 16px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(26,26,62,0.06); display: flex; align-items: center; gap: 10px; border-left: 4px solid @(isOverdue ? "#d9534f" : "#5cb85c");">
                        <strong>@todo.Title</strong>
                        @if (isOverdue)
                        {
                            <span style="background: #d9534f; color: white; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                                GECİKMİŞ
                            </span>
                        }
                        <span style="margin-left: auto; color: #888; font-size: 14px;">
                            @relevantDate?.ToLocalTime().ToString("dd MMMM, HH:mm")
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="color: #888;">Yaklaşan planın yok, harika gidiyorsun! 🎉</p>
        }

        <div style="text-align: center; margin-top: 20px;">
            <a class="btn btn-primary" href="todos" style="padding: 10px 28px; border-radius: 8px;">Tüm Planlarımı Gör</a>
        </div>
    </div>
}

@code {
    private bool isChecking = true;
    private bool isLoggedIn = false;
    private List<TodoItemDto> allTodos = new();
    private List<TodoItemDto> activeReminders = new();

    private int totalCount => allTodos.Count;
    private int completedCount => allTodos.Count(t => t.IsCompleted);
    private int pendingCount => allTodos.Count(t => !t.IsCompleted);

    private List<TodoItemDto> upcomingTodos
    {
        get
        {
            var threshold = DateTime.UtcNow.AddDays(3);

            return allTodos
                .Where(t => !t.IsCompleted && (t.StartDate.HasValue || t.DueDate.HasValue))
                .Where(t => (t.DueDate ?? t.StartDate) <= threshold)
                .OrderBy(t => t.DueDate ?? t.StartDate)
                .Take(5)
                .ToList();
        }
    }

    private class TodoItemDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? DueDate { get; set; }
    }

    private class PagedResult
    {
        public List<TodoItemDto> Items { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>("localStorageHelper.getItem", "accessToken");
        isLoggedIn = !string.IsNullOrEmpty(token);
        isChecking = false;

        if (isLoggedIn)
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            await LoadDashboardData();
        }
    }

    private async Task LoadDashboardData()
    {
        var todosResponse = await Api.GetAsync("api/todos?pageSize=100");
        if (todosResponse.IsSuccessStatusCode)
        {
            var result = await todosResponse.Content.ReadFromJsonAsync<PagedResult>();
            allTodos = result?.Items ?? new();
        }

        var remindersResponse = await Api.GetAsync("api/todos/reminders");
        if (remindersResponse.IsSuccessStatusCode)
        {
            activeReminders = await remindersResponse.Content.ReadFromJsonAsync<List<TodoItemDto>>() ?? new();
        }
    }

    private string GetGreeting()
    {
        var today = DateTime.UtcNow.Date;

        var todaysCount = allTodos.Count(t =>
            !t.IsCompleted &&
            ((t.DueDate.HasValue && t.DueDate.Value.ToLocalTime().Date == DateTime.Now.Date) ||
            (t.StartDate.HasValue && t.StartDate.Value.ToLocalTime().Date == DateTime.Now.Date)));

        if (todaysCount == 0)
        {
            return "Bugün planın yok, harika bir gün geçir! ✨";
        }

        return $"Bugün {todaysCount} planın var, hadi başlayalım! 🚀";
    }
}